# Mixpanel Analytics
# Get your token from: https://mixpanel.com/project/YOUR_PROJECT/settings
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# Google Forms Waitlist Configuration
# FORM_ID: Get from your Google Form URL (the part between /d/ and /edit)
# ENTRY_ID: Inspect the email field in form preview mode to find entry.XXXXXX
NEXT_PUBLIC_GOOGLE_FORM_ID=your_form_id_here
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_ID=your_entry_id_here
